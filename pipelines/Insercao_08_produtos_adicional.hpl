  <transform>
    <name>Inclui os dados em app_product_additional</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET @empresa = ${par_empresa_que_criou};


INSERT INTO app_product_additional (id_company, id_product, warranty, essential, situation, discontinued, purchase_cost,groupproduct,subgroup)

with cte_dados
AS
(
select
@empresa as id_company ,
(select app_products.id from app_products where app_products.original_cod = vvr_produtos.codigo_do_produto limit 1) as id_product,
0 as warranty,
0 as essential,
1 as situation,
0 as discontinued ,
round(vvr_produtos.preco_custo ,2)  as purchase_cost,
(SELECT
	app_product_group.id
FROM
	app_product_group
WHERE
	app_product_group.title = vvr_produtos.descricao_grupo
limit 1) as grupo,

(SELECT
	app_subgroup.id
FROM
	app_subgroup
WHERE
	app_subgroup.title = vvr_produtos.subgrupo
		
		AND app_subgroup.id_group =
(SELECT
	app_product_group.id
FROM
	app_product_group
WHERE
	app_product_group.title = vvr_produtos.descricao_grupo
limit 1)
) as subgrupo

from vvr_produtos
)


select 
cte_dados.id_company,
cte_dados.id_product,
cte_dados.warranty,
cte_dados.essential,
cte_dados.situation,
cte_dados.discontinued,
cte_dados.purchase_cost,
cte_dados.grupo,
cte_dados.subgrupo
from cte_dados
where
cte_dados.id_product is not null;

COMMIT;</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
