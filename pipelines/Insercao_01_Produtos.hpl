  <transform>
    <name>Inclui os dados em app_products</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>
SET @empresa_criou = ${par_empresa_que_criou};

SET @usuario = ${par_cod_usuario_suporte};# ID do usuário Suporte Vivon

SET @flagConversao = ${par_flag_da_conversao};

INSERT INTO app_products (conversion_flag, original_cod, id, gtin, description, ncm, cst, aliquot_icms, cest, sale_price, coast_price, path_photo, user_id_register, internal_validation, external_validation, user_id_validation, create_at, update_at, STATUS, orig, width, height, length, net_weight, gross_weight, avg_price, max_price, min_price, business_unit, cfop, csosn, reference, id_temp, tax_table, id_company_create, id_user_edit)
WITH cte_auxiliar AS (
	SELECT
		@flagConversao AS conversion_flag,
		vvr_produtos.codigo_do_produto AS original_cod,
		NULL AS id,
		LEFT ( trim( vvr_produtos.codigo_de_barras ), 20 ) AS gtin,
		vvr_produtos.descricao AS description,
		vvr_produtos.ncm AS ncm,
	CASE
			
			WHEN vvr_produtos.tax_table_01_ff_ii_nn = '01' THEN
			'000' ELSE '060' 
		END AS cst,
	CASE
			
			WHEN vvr_produtos.tax_table_01_ff_ii_nn = '01' THEN
			20 ELSE 0 
		END AS aliquot_icms,
	CASE
			
			WHEN vvr_produtos.tax_table_01_ff_ii_nn != '01' THEN
			vvr_produtos.cest ELSE '' 
		END AS cest,
		vvr_produtos.preco_venda AS sale_price,
		ROUND( vvr_produtos.preco_custo, 2 ) AS coast_price,
		NULL AS path_photo,
		cast( @usuario AS INTEGER ) AS user_id_register,
		cast(
		'N' AS CHAR ( 1 )) AS internal_validation,
		cast(
		'N' AS CHAR ( 1 )) AS external_validation,
		cast( @usuario AS INTEGER ) AS user_id_validation,
		CURRENT_TIMESTAMP AS create_at,
		CURRENT_TIMESTAMP AS update_at,
		cast( 1 AS INTEGER ) AS STATUS,
		cast( 0 AS INTEGER ) AS orig,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS width,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS height,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS length,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS net_weight,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS gross_weight,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS avg_price,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS max_price,
		cast(
		0 AS DECIMAL ( 18, 2 )) AS min_price,
		(
		SELECT
			app_business_unit.id 
		FROM
			app_business_unit 
		WHERE
			app_business_unit.unity = trim(
			upper( vvr_produtos.unidade_de_venda )) limit 1) AS business_unit,
	CASE
			
			WHEN vvr_produtos.tax_table_01_ff_ii_nn = '01' THEN
			'5102' ELSE '5405' 
		END AS cfop,
	CASE
			
			WHEN vvr_produtos.tax_table_01_ff_ii_nn = '01' THEN
			'102' ELSE '500' 
		END AS csosn,
		LEFT ( vvr_produtos.referencia, 30 ) AS reference,
		vvr_produtos.codigo_do_produto AS id_temp,
		COALESCE ( vvr_produtos.tax_table_01_ff_ii_nn, '' ) AS tax_table,
		@empresa_criou AS id_company_create,
		@usuario AS id_user_edit 
	FROM
		vvr_produtos 
	) 
SELECT
conversion_flag,
original_cod,
id,
gtin,
description,
ncm,
cst,
aliquot_icms,
cest,
sale_price,
coast_price,
path_photo,
user_id_register,
internal_validation,
external_validation,
user_id_validation,
create_at,
update_at,
STATUS,
orig,
width,
height,
length,
net_weight,
gross_weight,
avg_price,
max_price,
min_price,
business_unit,
cfop,
csosn,
reference,
id_temp,
tax_table,
id_company_create,
id_user_edit 
FROM
	cte_auxiliar;</sql>
