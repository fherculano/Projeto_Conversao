    <sql>/*_conversão ajuste das unidades*/

update vvr_produtos
set vvr_produtos.unidade_de_venda = 'UNID'
where
vvr_produtos.unidade_de_venda is null
or
vvr_produtos.unidade_de_venda
in
(
'unid.'
'bld',
'07',
'07',
'21',
'28',
'51',
'%',
'0',
'001',
'01',
'04',
