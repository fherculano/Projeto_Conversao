    <connection>DB_DEV_CONVERSAO</connection>
    <sql>SELECT DISTINCT
COUNT(vvr_produtos.unidade_de_venda) as quant_de_unidades_fora_do_padrao
FROM vvr_produtos
WHERE
NOT EXISTS ( SELECT 1 FROM app_business_unit u WHERE u.unity = vvr_produtos.unidade_de_venda)
ORDER BY 1;</sql>
    <limit>0</limit>
    <lookup/>
