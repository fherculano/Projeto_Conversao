    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE app_type_product;
SET FOREIGN_KEY_CHECKS = 1;</sql>
    <attributes/>
    <GUI>
      <xloc>208</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_type_product</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>N</single_statement>
    <sql>
SET @empresa = ${par_empresa_que_criou};
SET @user_suport = ${par_cod_usuario_suporte};

INSERT INTO app_type_product(id, id_company, id_product, id_product_type, id_user_edit)
SELECT DISTINCT
  null as id,
	@empresa, 
	id as id_product, 
	1 as id_product_type, 
	@user_suport as id_user_edit
FROM
	app_products
WHERE
  NOT EXISTS ( SELECT 1 FROM app_type_product u WHERE u.id_product = app_products.id and u.id_company = @empresa );	</sql>
    <attributes/>
    <GUI>
      <xloc>592</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
