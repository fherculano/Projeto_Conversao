    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>N</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE app_subgroup;
SET FOREIGN_KEY_CHECKS = 1;
COMMIT;</sql>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_subgroup</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>
SET @empresa = ${par_empresa_que_criou};
SET @id_user_suporte = ${par_cod_usuario_suporte};

INSERT INTO app_subgroup (id, id_company, id_group, title, id_user, situation, profitability, profitability_wholesale, profitability_promotion)
SELECT DISTINCT
  NULL,
	@empresa,
	(select app_product_group.id from app_product_group where app_product_group.title = vvr_produtos.descricao_grupo) as id_grupo,
   vvr_produtos.subgrupo,
	 @id_user_suporte,
1,	 
0,
0,
0 
FROM
	vvr_produtos
having vvr_produtos.subgrupo is not null and id_grupo is not null;
COMMIT;
	</sql>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
