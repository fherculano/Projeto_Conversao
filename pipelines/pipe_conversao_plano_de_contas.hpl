    <single_statement>Y</single_statement>
    <sql>DROP TABLE IF EXISTS vvr_plano_de_contas;


CREATE TABLE vvr_plano_de_contas
(
  id INT AUTO_INCREMENT PRIMARY KEY
,  codigo INT
, classificacao TINYTEXT
, tipo TINYTEXT
, descricao TINYTEXT
);

COMMIT;
</sql>
