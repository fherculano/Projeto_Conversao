  <transform>
    <name>Inclui os dados em app_product_tax</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>N</single_statement>
    <sql>SET @empresa = ${par_empresa_que_criou};
SET @usuario = ${par_cod_usuario_suporte};;


INSERT IGNORE INTO app_product_tax(id, id_company, id_product, cst, csosn, cfop, ncm, cest, aliquot_icms, status, update_at, tax_table, id_user_update, id_user_create, pis, cofins, tax_substitution, icms_credit, icms_difference, icms_st, ipi, icms_st_ipi, icms_ipi, irpj, csll, id_user_edit, app_product_taxcol) 
SELECT DISTINCT
	null as id, 
	@empresa as id_company, 
	app_products.id as id_product, 
	app_products.cst, 
	app_products.csosn, 
	app_products.cfop, 
	app_products.ncm, 
	app_products.cest, 
	app_products.aliquot_icms, 
	app_products.`status`, 
	app_products.update_at, 
	app_products.tax_table, 
	@usuario as id_user_update, 
	@usuario as id_user_create, 
	app_products.pis, 
	app_products.cofins, 
	'all' as tax_substitution, 
	app_products.icms_credit, 
	app_products.icms_difference, 
	app_products.icms_st, 
	app_products.ipi, 
	app_products.icms_st_ipi, 
	app_products.icms_ipi, 
	app_products.irpj, 
	app_products.csll, 
	@usuario as id_user_edit, 
	null as app_product_taxcol
FROM
	app_products
WHERE
  NOT EXISTS ( SELECT 1 FROM app_product_tax u WHERE u.id_product = app_products.id and u.id_company = @empresa )	</sql>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
