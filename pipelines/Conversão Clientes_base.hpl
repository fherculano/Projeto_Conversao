      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

function ifnull(valor, valorPadrao) {
  return valor !== null &amp;&amp; valor !== undefined ? valor : valorPadrao;
}

function tiraAcentos(atexto) {
  var texto = atexto;
	texto = texto.replace(/[áàâäãå]/g, "a");
	texto = texto.replace(/[ÁÀÂÄÃÅ]/g, "A");
	texto = texto.replace(/[éèêë]/g, "e");
	texto = texto.replace(/[ÉÈÊË]/g, "E");
	texto = texto.replace(/[íìîï]/g, "i");
	texto = texto.replace(/[ÍÌÎÏ]/g, "I");
	texto = texto.replace(/[óòôöõ]/g, "o");
	texto = texto.replace(/[ÓÒÔÖÕ]/g, "O");
	texto = texto.replace(/[úùûü]/g, "u");
	texto = texto.replace(/[ÚÙÛÜ]/g, "U");
	texto = texto.replace(/[ç]/g, "c");
	texto = texto.replace(/[Ç]/g, "C");
	texto = texto.replace(/[ñ]/g, "n");
	texto = texto.replace(/[Ñ]/g, "N");
  return texto;
}

function tiraNaoAlfaNum(atexto) {
  var texto = atexto;
	texto = texto.replace(/[^a-zA-Z0-9&amp;]/g, " ");
  return texto;
}

function tiraMaisDeUmEspaço(atexto) {
  var texto = atexto;
	texto = texto.replace(/  +/g, " ");
  return texto;
}


function possuiApenasNumeros(s) {
  return /^[0-9]+$/.test(s);
}


function extrairNumeros(texto) {
  if (texto == null) {
    return ""; // Retorna string vazia se o texto for nulo
  }
  
  var numeros = texto.replace(/\D/g, ''); // Remove tudo que não é número
  return numeros;
}


function converterValores(valorString) {
    if (valorString == null || valorString === undefined || valorString === '') {
      return 0;
    }

    var valorSemPontos = valorString.replace(/\./g, '');
    var valorComPonto = valorSemPontos.replace(/,/g, '.');

    if (valorComPonto === '') {
       return 0;
    }

    var valorNumerico = parseFloat(valorComPonto);

    if (isNaN(valorNumerico)) {
       return 0;
    }

    return valorNumerico;
}


//CAMPOS ========================================

// codigo_do_cliente
// nome_do_cliente
// cpf_cnpj
// rg_inscricao_estadual
// endereco
// num_endereco
// bairro
// cep
// cidade
// uf
// cod_ibge_cidade
// ponto_de_referência
// telefone
// celular
// data_nascimento
// limite_credito
// email
// conjuge
// conjuge_cpf
// nome_pai
// nome_mae
// observacoes

//CAMPOS NUMERICOS ==================================

// codigo_do_cliente
// cpf_cnpj
// rg_inscricao_estadual
// num_endereco
// cep
// cod_ibge_cidade
// telefone
// celular
// conjuge_cpf

//CAMPOS VALOR ======================================

// limite_credito



//AJUSTA OS CAMPOS NULOS ======================================

if (codigo_do_cliente !== null) {
codigo_do_cliente = codigo_do_cliente.replace('\\N','');
}

if (nome_do_cliente !== null) {
nome_do_cliente = nome_do_cliente.replace('\\N','');
}

if (cpf_cnpj !== null) {
cpf_cnpj = cpf_cnpj.replace('\\N','');
}

if (rg_inscricao_estadual !== null) {
rg_inscricao_estadual = rg_inscricao_estadual.replace('\\N','');
}

if (endereco !== null) {
endereco = endereco.replace('\\N','');
}

if (num_endereco !== null) {
num_endereco = num_endereco.replace('\\N','');
}

if (bairro !== null) {
bairro = bairro.replace('\\N','');
}

if (cep !== null) {
cep = cep.replace('\\N','');
}

if (cidade !== null) {
cidade = cidade.replace('\\N','');
}

if (uf !== null) {
uf = uf.replace('\\N','');
}

if (cod_ibge_cidade !== null) {
cod_ibge_cidade = cod_ibge_cidade.replace('\\N','');
}

if (ponto_de_referência !== null) {
ponto_de_referência = ponto_de_referência.replace('\\N','');
}

if (telefone !== null) {
telefone = telefone.replace('\\N','');
}

if (celular !== null) {
celular = celular.replace('\\N','');
}

if (data_nascimento !== null) {
data_nascimento = data_nascimento.replace('\\N','');
}

if (limite_credito !== null) {
limite_credito = limite_credito.replace('\\N','');
}

if (email !== null) {
email = email.replace('\\N','');
}

if (conjuge !== null) {
conjuge = conjuge.replace('\\N','');
}

if (conjuge_cpf !== null) {
conjuge_cpf = conjuge_cpf.replace('\\N','');
}

if (nome_pai !== null) {
nome_pai = nome_pai.replace('\\N','');
}

if (nome_mae !== null) {
nome_mae = nome_mae.replace('\\N','');
}

if (observacoes !== null) {
observacoes = observacoes.replace('\\N','');
}


//RETIRA OS ACENTOS E CARACTERES NÃO ALFANUMERICOS ========================

nome_do_cliente = tiraAcentos(ifnull(nome_do_cliente,"")); 

nome_do_cliente = tiraNaoAlfaNum(ifnull(nome_do_cliente,"")); 

nome_do_cliente = upper(nome_do_cliente); 

nome_do_cliente = tiraMaisDeUmEspaço(ifnull(nome_do_cliente,"")); 

//=====


endereco = tiraAcentos(ifnull(endereco,"")); 

endereco = tiraNaoAlfaNum(ifnull(endereco,"")); 

endereco = upper(endereco); 

endereco = tiraMaisDeUmEspaço(ifnull(endereco,"")); 

//=====

cidade = tiraAcentos(ifnull(cidade,"")); 

cidade = tiraNaoAlfaNum(ifnull(cidade,"")); 

cidade = upper(cidade); 

cidade = tiraMaisDeUmEspaço(ifnull(cidade,"")); 

//=====


bairro = tiraAcentos(ifnull(bairro,"")); 

bairro = tiraNaoAlfaNum(ifnull(bairro,"")); 

bairro = upper(bairro); 

bairro = tiraMaisDeUmEspaço(ifnull(bairro,"")); 

// EXTRAI OS CARACTERES NÃO NUMERICOS DOS CAMPOS NUMERICOS ==================================

codigo_do_cliente = extrairNumeros(codigo_do_cliente);
cpf_cnpj = extrairNumeros(cpf_cnpj);
rg_inscricao_estadual = extrairNumeros(rg_inscricao_estadual);
num_endereco = extrairNumeros(num_endereco);
cep = extrairNumeros(cep);
cod_ibge_cidade = extrairNumeros(cod_ibge_cidade);
telefone = extrairNumeros(telefone);
celular = extrairNumeros(celular);
conjuge_cpf = extrairNumeros(conjuge_cpf);

// CONVERTE VALORES (#.###,## PARA ####.##) NOS CAMPOS DE VALOR =============================

limite_credito = converterValores(limite_credito);

//TRATAMENTO DE DADOS =======================================================================


telefone = extrairNumeros(telefone);

if (uf != null &amp;&amp; uf !== undefined &amp;&amp; String(uf).length !== 2) {
    uf = null;
}

cep = extrairNumeros(cep);

if (cep != null &amp;&amp; cep !== undefined &amp;&amp; String(cep).length !== 8) {
    cep = null;
}

cod_ibge_cidade = extrairNumeros(cod_ibge_cidade);

if (cod_ibge_cidade != null &amp;&amp; cod_ibge_cidade !== undefined &amp;&amp; String(cod_ibge_cidade).length !== 7) {
    cod_ibge_cidade = null;
}


if (rg_inscricao_estadual != null &amp;&amp; rg_inscricao_estadual !== undefined &amp;&amp; String(rg_inscricao_estadual).length &lt; 4) {
    rg_inscricao_estadual = null;
}

if (email != null &amp;&amp; email !== undefined &amp;&amp; String(email).length &lt; 4) {
    email = null;
}

if (cpf_cnpj != null &amp;&amp; cpf_cnpj !== undefined) {
    var tamanho = String(cpf_cnpj).length;
    if (tamanho !== 11 &amp;&amp; tamanho !== 14) {
        cpf_cnpj = null;
    }
}

if ((num_endereco == '0') || (num_endereco == null)) {
num_endereco = 'SN';
}



</jsScript_script>
      </jsScript>
    </jsScripts>
