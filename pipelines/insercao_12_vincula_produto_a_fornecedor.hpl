    <sql>-- Passo 1: Criar a tabela temporária (simulando o CTE)
CREATE TEMPORARY TABLE temp_cte AS
WITH cte_base AS (
    SELECT
      (
        SELECT
          app_products.id
        FROM
          app_products
        WHERE
          app_products.original_cod = vvr_produtos.codigo_do_produto
      ) AS novo_id_produto,
      (
        SELECT
          app_participants.id
        FROM
          app_participants
        WHERE
          app_participants.original_cod = concat('for_', vvr_fornecedores.codigo_do_fornecedor)
      ) AS novo_id_fornecedor
    FROM
      vvr_produtos
      INNER JOIN vvr_fornecedores ON vvr_produtos.razao_fornecedor_principal = vvr_fornecedores.Fornecedor
      INNER JOIN app_participants ON vvr_fornecedores.Fornecedor = app_participants.`name`
  ),
  cte_final AS (
    SELECT
        MAX(cte_base.novo_id_fornecedor) AS id_fornecedor,
        cte_base.novo_id_produto
    FROM
        cte_base
    WHERE
        novo_id_produto IS NOT NULL
        AND novo_id_fornecedor IS NOT NULL
    GROUP BY
        novo_id_produto
)

SELECT
	id_fornecedor,
    novo_id_produto
FROM
    cte_final;

-- Passo 2: Atualizar a tabela app_product_additional usando a tabela temporária
UPDATE app_product_additional
INNER JOIN temp_cte ON app_product_additional.id_product = temp_cte.novo_id_produto
SET app_product_additional.id_provider_default = temp_cte.id_fornecedor;

-- Passo 3: Limpar a tabela temporária
DROP TEMPORARY TABLE IF EXISTS temp_cte;</sql>
