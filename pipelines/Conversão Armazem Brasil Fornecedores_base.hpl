        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

function ifnull(valor, valorPadrao) {
  return valor !== null &amp;&amp; valor !== undefined ? valor : valorPadrao;
}

function tiraAcentos(atexto) {
  var texto = atexto;
	texto = texto.replace(/[áàâäãå]/g, "a");
	texto = texto.replace(/[ÁÀÂÄÃÅ]/g, "A");
	texto = texto.replace(/[éèêë]/g, "e");
	texto = texto.replace(/[ÉÈÊË]/g, "E");
	texto = texto.replace(/[íìîï]/g, "i");
	texto = texto.replace(/[ÍÌÎÏ]/g, "I");
	texto = texto.replace(/[óòôöõ]/g, "o");
	texto = texto.replace(/[ÓÒÔÖÕ]/g, "O");
	texto = texto.replace(/[úùûü]/g, "u");
	texto = texto.replace(/[ÚÙÛÜ]/g, "U");
	texto = texto.replace(/[ç]/g, "c");
	texto = texto.replace(/[Ç]/g, "C");
	texto = texto.replace(/[ñ]/g, "n");
	texto = texto.replace(/[Ñ]/g, "N");
  return texto;
}

function tiraNaoAlfaNum(atexto) {
  var texto = atexto;
	texto = texto.replace(/[^a-zA-Z0-9&amp;]/g, " ");
  return texto;
}

function tiraMaisDeUmEspaço(atexto) {
  var texto = atexto;
	texto = texto.replace(/  +/g, " ");
  return texto;
}


function possuiApenasNumeros(s) {
  return /^[0-9]+$/.test(s);
}


function extrairNumeros(texto) {
  if (texto == null) {
    return ""; // Retorna string vazia se o texto for nulo
  }
  
  var numeros = texto.replace(/\D/g, ''); // Remove tudo que não é número
  return numeros;
}


function converterValores(valorString) {
  if (valorString == null) {
      return ""; // Retorna string vazia se o preço for nulo
  }
  
  var valorSemPontos = valorString.replace(/\./g, ''); // Remove os pontos
  var valorComPonto = valorSemPontos.replace(/,/g, '.'); // Substitui a vírgula por ponto
  return valorComPonto;
}

//===========================================================


//Replaces pre

codigo_do_fornecedor = ifnull(codigo_do_fornecedor, "").replace('\\N','');

cpf_cnpj = ifnull(cpf_cnpj, "").replace('\\N','');

insc_estadual = ifnull(insc_estadual, "").replace('\\N','');

fornecedor = ifnull(fornecedor, "").replace('\\N','');

nome_fantasia = ifnull(nome_fantasia, "").replace('\\N','');

endereco = ifnull(endereco, "").replace('\\N','');

numero_endereco = ifnull(numero_endereco, "").replace('\\N','');

cep = ifnull(cep, "").replace('\\N','');

codigo_ibge_cidade = ifnull(codigo_ibge_cidade, "").replace('\\N','');

bairro = ifnull(bairro, "").replace('\\N','');

cidade = ifnull(cidade, "").replace('\\N','');

uf = ifnull(uf, "").replace('\\N','');

fone1 = ifnull(fone1, "").replace('\\N','');

email = ifnull(email, "").replace('\\N','');


/*
if (ncm == null) {
      ncm = '';
  }

ncm = ncm.replace('\\N','');


//Retira os acentos
*/
fornecedor = tiraAcentos(ifnull(fornecedor,"")); 

fornecedor = tiraNaoAlfaNum(ifnull(fornecedor,"")); 

fornecedor = upper(fornecedor); 

fornecedor = tiraMaisDeUmEspaço(ifnull(fornecedor,"")); 

//=====

nome_fantasia = tiraAcentos(ifnull(nome_fantasia,"")); 

nome_fantasia = tiraNaoAlfaNum(ifnull(nome_fantasia,"")); 

nome_fantasia = upper(nome_fantasia); 

nome_fantasia = tiraMaisDeUmEspaço(ifnull(nome_fantasia,"")); 
//=====

endereco = tiraAcentos(ifnull(endereco,"")); 

endereco = tiraNaoAlfaNum(ifnull(endereco,"")); 

endereco = upper(endereco); 

endereco = tiraMaisDeUmEspaço(ifnull(endereco,"")); 

//=====

cidade = tiraAcentos(ifnull(cidade,"")); 

cidade = tiraNaoAlfaNum(ifnull(cidade,"")); 

cidade = upper(cidade); 

cidade = tiraMaisDeUmEspaço(ifnull(cidade,"")); 

//=====


bairro = tiraAcentos(ifnull(bairro,"")); 

bairro = tiraNaoAlfaNum(ifnull(bairro,"")); 

bairro = upper(bairro); 

bairro = tiraMaisDeUmEspaço(ifnull(bairro,"")); 

//=====
/*
subgrupo = tiraAcentos(ifnull(subgrupo,"")); 

subgrupo = tiraNaoAlfaNum(ifnull(subgrupo,"")); 

subgrupo = upper(subgrupo); 

subgrupo = tiraMaisDeUmEspaço(ifnull(subgrupo,""));

//=====


nome_da_marca = tiraAcentos(ifnull(nome_da_marca,"")); 

nome_da_marca = tiraNaoAlfaNum(ifnull(nome_da_marca,"")); 

nome_da_marca = upper(nome_da_marca); 

nome_da_marca = tiraMaisDeUmEspaço(ifnull(nome_da_marca,""));



//Retira os caracteres não numéricos
codigo_de_barras = extrairNumeros(codigo_de_barras); 
ncm = extrairNumeros(ncm); 
cest = extrairNumeros(cest); 

//Converte valores (#.###,## para ####.##)

preco_venda = converterValores(preco_venda);

estoque = converterValores(estoque);

estoque_minimo = converterValores(estoque_minimo);

preco_custo = converterValores(preco_custo);

margem = converterValores(margem);

//Extrair só Numeros

cfop = extrairNumeros(cfop);

//Replaces pós

descricao_grupo = descricao_grupo.replace('DECOR AAO','DECORACAO');
*/

//Tratamento de dados

fone1 = extrairNumeros(fone1);

if (uf != null &amp;&amp; uf !== undefined &amp;&amp; String(uf).length !== 2) {
    uf = null;
}

cep = extrairNumeros(cep);

if (cep != null &amp;&amp; cep !== undefined &amp;&amp; String(cep).length !== 8) {
    cep = null;
}

codigo_ibge_cidade = extrairNumeros(codigo_ibge_cidade);

if (codigo_ibge_cidade != null &amp;&amp; codigo_ibge_cidade !== undefined &amp;&amp; String(codigo_ibge_cidade).length !== 7) {
    codigo_ibge_cidade = null;
}

if (insc_estadual != null &amp;&amp; insc_estadual !== undefined &amp;&amp; String(insc_estadual).length &lt; 4) {
    insc_estadual = null;
}

if (email != null &amp;&amp; email !== undefined &amp;&amp; String(email).length &lt; 4) {
    email = null;
}

if (cpf_cnpj != null &amp;&amp; cpf_cnpj !== undefined) {
    var tamanho = String(cpf_cnpj).length;
    if (tamanho !== 11 &amp;&amp; tamanho !== 14) {
        cpf_cnpj = null;
    }
}

if ((numero_endereco == '0') || (numero_endereco == null)) {
numero_endereco = 'SN';
}</jsScript_script>
      </jsScript>
