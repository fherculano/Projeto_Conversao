  </transform>
  <transform>
    <name>Esvazia a tabela app_participants_additional</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>COMMIT;
SET FOREIGN_KEY_CHECKS = 0;
DELETE FROM app_participants_additional WHERE id >= ${par_cod_primeiro_participante};
COMMIT;
alter table app_participants_additional auto_increment = ${par_cod_primeiro_participante};
SET FOREIGN_KEY_CHECKS = 1;

</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_participants_additional</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET @empresa = ${par_empresa_que_criou};

INSERT INTO app_participants_additional (id, id_company, situation, id_participant)
SELECT
    NULL AS id,
    @empresa AS id_company,
    1 AS situation,
    p.id AS id_participant -- Pega o ID diretamente do JOIN
FROM
    vvr_fornecedores AS vf
-- Usa INNER JOIN para garantir que só pegamos fornecedores que já existem em app_participants
INNER JOIN 
    app_participants AS p ON p.document = NumericOnly(vf.cpf_cnpj)
WHERE
    vf.cpf_cnpj &lt;&gt; ''
    AND vf.Fornecedor &lt;&gt; ''
    AND CHAR_LENGTH(NumericOnly(vf.cpf_cnpj)) IN (11, 14)
    -- A condição NOT EXISTS agora verifica se o ID do participante já está na tabela de adicionais
    AND NOT EXISTS (
        SELECT 1
        FROM app_participants_additional AS pa
        WHERE pa.id_participant = p.id
    );</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>720</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
