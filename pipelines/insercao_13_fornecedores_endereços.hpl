<pipeline>
  <info>
    <name>insercao_13_fornecedores_endereços</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>par_cod_primeiro_participante</name>
        <default_value>6</default_value>
        <description>Código do primeiro participante após os cadastrados manualmente</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2024/12/26 16:23:18.415</created_date>
    <modified_user>-</modified_user>
    <modified_date>2024/12/26 16:23:18.415</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Ao rodar essa transformação preencha os seguintes parametros
ao iniciar:

Código do primeiro participante</note>
      <xloc>0</xloc>
      <yloc>0</yloc>
      <width>362</width>
      <heigth>73</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <fontbold>Y</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>205</backgroundcolorgreen>
      <backgroundcolorblue>112</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Esvazia a tabela app_participants_address</from>
      <to>Inicializa o autoincremento</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Inicializa o autoincremento</from>
      <to>Inclui os dados em app_participants_address</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Esvazia a tabela app_participants_address</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>SET FOREIGN_KEY_CHECKS = 0;
DELETE FROM app_participants_address WHERE id_participant >= ${par_cod_primeiro_participante};
SET FOREIGN_KEY_CHECKS = 1;</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <GUI>
      <xloc>128</xloc>
      <yloc>176</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_participants_address</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>INSERT INTO app_participants_address(ID, id_participant, ADDRESS, CITY, NEIGHBORHOOD, STATE, NUMBER, COMPLEMENT, COUNTRY, CODE_IBGE_CITY, STATUS, CMUN, LAT, LNG, address_default, zipcode)
SELECT
    NULL AS ID,
    p.id AS id_participant, -- Pega o ID diretamente do JOIN
    UPPER(COALESCE(vf.endereco, '')) AS ADDRESS,
    UPPER(COALESCE(vf.Cidade, '')) AS CITY,
    UPPER(COALESCE(vf.Bairro, '')) AS NEIGHBORHOOD,
    UPPER(COALESCE(vf.UF, 'PB')) AS STATE,
    UPPER(COALESCE(vf.numero_endereco, 'SN')) AS NUMBER,
    '' AS COMPLEMENT,
    'BRASIL' AS COUNTRY,
    vf.codigo_ibge_cidade AS CODE_IBGE_CITY,
    1 AS STATUS,
    vf.codigo_ibge_cidade AS CMUN,
    NULL AS LAT,
    NULL AS LNG,
    1 AS address_default,
    vf.cep AS zipcode
FROM
    vvr_fornecedores AS vf
-- Garante que só processamos fornecedores que existem em app_participants
INNER JOIN 
    app_participants AS p ON p.document = NumericOnly(vf.cpf_cnpj)
WHERE
    vf.cpf_cnpj &lt;&gt; ''
    AND vf.Fornecedor &lt;&gt; ''
    -- Verifica se um endereço para este participante já não foi inserido
    AND NOT EXISTS (
        SELECT 1
        FROM app_participants_address u
        WHERE u.id_participant = p.id
    );</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <GUI>
      <xloc>544</xloc>
      <yloc>176</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Inicializa o autoincremento</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>alter table app_participants_address auto_increment = ${par_cod_primeiro_participante};</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <GUI>
      <xloc>336</xloc>
      <yloc>176</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
