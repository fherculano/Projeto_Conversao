<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>insercao_10_fornecedores</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>par_cod_primeiro_participante</name>
        <default_value>6</default_value>
        <description>Código do primeiro participante após os cadastrados manualmente</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2024/12/26 16:23:18.415</created_date>
    <modified_user>-</modified_user>
    <modified_date>2024/12/26 16:23:18.415</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>112</backgroundcolorblue>
      <backgroundcolorgreen>205</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>9</fontsize>
      <height>-1</height>
      <xloc>0</xloc>
      <yloc>0</yloc>
      <note>Ao rodar essa transformação preencha os seguintes parametros
ao iniciar:

Código do primeiro participante</note>
      <width>345</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Esvazia a tabela participants</from>
      <to>Inclui os dados em app_participants</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Esvazia a tabela participants</name>
    <type>ExecSql</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET FOREIGN_KEY_CHECKS = 0;

-- Apaga os dados das tabelas filhas primeiro
DELETE FROM app_participants_relationships WHERE id_participant >= ${par_cod_primeiro_participante};
DELETE FROM app_participants_additional WHERE id_participant >= ${par_cod_primeiro_participante};

-- Agora, apaga os dados da tabela pai
DELETE FROM app_participants WHERE id >= ${par_cod_primeiro_participante};

-- Seta o autoincremento (ALTER TABLE só funciona com TRUNCATE, mas podemos setá-lo assim)
ALTER TABLE app_participants AUTO_INCREMENT = ${par_cod_primeiro_participante};

SET FOREIGN_KEY_CHECKS = 1;

COMMIT;

alter table app_participants auto_increment = ${par_cod_primeiro_participante};
COMMIT;


</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_participants</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>N</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>INSERT INTO app_participants (id, name, document, auxiliary_document, nickname, conversion_flag, original_cod)
SELECT
    NULL,
    vf.Fornecedor AS name,
    NumericOnly(vf.cpf_cnpj) AS document,
    NumericOnly(vf.insc_estadual) AS auxiliary_document,
    vf.nome_fantasia AS nickname,
    1 AS conversion_flag,
    CONCAT('for_', vf.codigo_do_fornecedor) AS original_cod
FROM
    vvr_fornecedores AS vf
-- Tenta encontrar uma correspondência em app_participants
LEFT JOIN 
    app_participants AS p ON p.document = NumericOnly(vf.cpf_cnpj)
WHERE
    -- A condição principal: só queremos linhas onde NÃO houve correspondência
    p.id IS NULL
    -- Mantém seus filtros originais
    AND vf.cpf_cnpj &lt;&gt; ''
    AND vf.Fornecedor &lt;&gt; ''
    AND CHAR_LENGTH(NumericOnly(vf.cpf_cnpj)) IN (11, 14);</sql>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
