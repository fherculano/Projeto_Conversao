    <sql>INSERT INTO app_participants_address(id, id_participant, address, city, neighborhood, state, number, complement, country, code_ibge_city, status, cmun, lat, lng,address_default)

SELECT
    NULL AS ID,
    ap.id AS id_participant,
    UPPER(COALESCE(vc.endereco, '')) AS ADDRESS,
    UPPER(COALESCE(vc.Cidade, '')) AS CITY,
    UPPER(COALESCE(vc.Bairro, '')) AS NEIGHBORHOOD,
    UPPER(COALESCE(vc.UF, 'PB')) AS STATE,
    UPPER(COALESCE(vc.num_endereco, 'SN')) AS NUMBER,
    '' AS COMPLEMENT,
    'BRASIL' AS COUNTRY,
    vc.cod_ibge_cidade AS CODE_IBGE_CITY,
    1 AS STATUS,
    vc.cod_ibge_cidade AS CMUN,
    NULL AS LAT,
    NULL AS LNG,
    1 AS address_default
FROM
    vvr_clientes vc
INNER JOIN
    app_participants ap ON ap.document = NumericOnlyRegex(vc.cpf_cnpj)
LEFT JOIN
    app_participants_address apa ON apa.id_participant = ap.id
WHERE
    vc.cpf_cnpj IS NOT NULL
    AND vc.cpf_cnpj &lt;&gt; ''
    AND vc.nome_do_cliente &lt;&gt; ''
    AND apa.id_participant IS NULL;

</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>80</yloc>
    </GUI>
