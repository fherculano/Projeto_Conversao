      <xloc>176</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_products_gtin</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>
SET @empresa = ${par_empresa_que_criou};

INSERT INTO app_products_gtin(id_company, id_product, gtin, gtin_input, gtin_default, purchase_multiple, multiple_sale)
SELECT
	@empresa as id_company,
	app_products.id as id_product,
	app_products.gtin as gtin,
	app_products.gtin as gtin_input,
	1 as gtin_default,
	1 as purchase_multiple,
	1 as multiple_sale 
FROM
	vvr_produtos, app_products
	WHERE 
	app_products.original_cod &lt;&gt; ''
	AND
  vvr_produtos.codigo_do_produto = app_products.original_cod;


</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <GUI>
      <xloc>560</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
