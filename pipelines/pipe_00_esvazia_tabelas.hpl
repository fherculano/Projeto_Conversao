    <sql>-- Desabilita a verificação de chaves estrangeiras
SET FOREIGN_KEY_CHECKS = 0;

-- Limpa as tabelas e reseta o autoincremento
TRUNCATE TABLE app_product_tax;
TRUNCATE TABLE app_products_gtin;
TRUNCATE TABLE app_product_additional;
TRUNCATE TABLE app_type_product;
TRUNCATE TABLE app_product_group;
TRUNCATE TABLE app_subgroup;
TRUNCATE TABLE app_products_price;
TRUNCATE TABLE app_products_price_temp_calc;
TRUNCATE TABLE app_products_business_unit;
-- A tabela de produtos (pai) deve ser uma das últimas a ser limpa
TRUNCATE TABLE app_products; 

-- Reabilita a verificação de chaves estrangeiras
SET FOREIGN_KEY_CHECKS = 1;</sql>
