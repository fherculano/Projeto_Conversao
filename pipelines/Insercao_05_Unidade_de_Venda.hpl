  <transform>
    <name>Esvazia a tabela app_products_business_unit</name>
    <type>ExecSql</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE app_products_business_unit;
SET FOREIGN_KEY_CHECKS = 1;
COMMIT;</sql>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os dados em app_products_business_unit</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET @empresa = ${par_empresa_que_criou};
SET @id_user_suporte = ${par_cod_usuario_suporte};

 INSERT IGNORE INTO app_products_business_unit (
	 id, 
	 id_company, 
	 id_product, 
	 id_business_unit, 
	 user_id, 
	 create_at, 
	 update_at, 
	 id_user_edit          
             
 )
 
SELECT DISTINCT
null,
@empresa as empresa,
app_products.id,
app_products.business_unit,
@id_user_suporte,
CURRENT_TIMESTAMP,
CURRENT_TIMESTAMP,
@id_user_suporte
FROM
	app_products
WHERE
  NOT EXISTS ( SELECT 1 FROM app_products_business_unit u WHERE u.id_product = app_products.id and u.id_company = @empresa );	
COMMIT;</sql>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inicializa o autoincremento</name>
    <type>ExecSql</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
