    <replace_variables>N</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>alter table app_products_business_unit auto_increment = 1;</sql>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
