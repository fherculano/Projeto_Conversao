  <transform>
    <name>Inclui os dados em app_participants_relationship</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>INSERT INTO app_participants_relationships (id_company, id_participant_category, id_participant, user_id, status) 
SELECT
  ${par_empresa_que_criou} as id_company,
  CASE
    WHEN LEFT(app_participants.original_cod,4) = 'for_' THEN
      2
    ELSE
      1
  END AS id_participant_category,
 app_participants.id as id_participant,
  ${par_cod_usuario_suporte} as user_id,
  1 as  status
FROM app_participants
WHERE
NOT EXISTS ( SELECT 1 FROM app_participants_relationships u WHERE u.id_participant = app_participants.id);
</sql>
    <set_params>N</set_params>
