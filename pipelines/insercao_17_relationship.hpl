    </GUI>
  </transform>
  <transform>
    <name>atualiza o id_participant_local em app_participants_relationship</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>
UPDATE app_participants_relationships 
SET app_participants_relationships.id_participant_local = app_participants_relationships.id_participant
WHERE
app_participants_relationships.id_participant IN 
(SELECT app_participants.id FROM app_participants WHERE app_participants.conversion_flag = 1);</sql>
