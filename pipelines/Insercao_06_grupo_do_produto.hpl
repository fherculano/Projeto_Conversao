  <transform>
    <name>Inclui os dados em app_product_group</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>SET @empresa = ${par_empresa_que_criou};


INSERT INTO app_product_group (id, id_company, title, situation)

with cte_grupo
as
(
select distinct
null as id,
@empresa as id_company, 
vvr_produtos.descricao_grupo as title,
1 as situation
from vvr_produtos
WHERE
  NOT EXISTS ( SELECT 1 FROM app_product_group u WHERE u.title = vvr_produtos.descricao_grupo )	
)

select * from cte_grupo
where
title is not null;

COMMIT;	</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
