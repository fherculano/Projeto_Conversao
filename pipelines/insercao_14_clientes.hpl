    <single_statement>Y</single_statement>
    <sql>SET FOREIGN_KEY_CHECKS = 0;
DELETE FROM app_participants WHERE app_participants.original_cod like 'cli_%';
SET FOREIGN_KEY_CHECKS = 1;
COMMIT;

</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Inclui os clientes em app_participants</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
</arguments>
    <connection>DB_DEV_CONVERSAO</connection>
    <delete_field/>
    <execute_each_row>N</execute_each_row>
    <insert_field/>
    <quoteString>N</quoteString>
    <read_field/>
    <replace_variables>N</replace_variables>
    <set_params>N</set_params>
    <single_statement>Y</single_statement>
    <sql>INSERT INTO app_participants(name, document, auxiliary_document, conversion_flag, datebirth, original_cod)
SELECT
  vvr_clientes.nome_do_cliente AS name,
  NumericOnly(vvr_clientes.cpf_cnpj) AS document,
	NumericOnly(vvr_clientes.rg_inscricao_estadual) AS auxiliary_document,
	1 as conversion_flag,
	  CASE
		WHEN vvr_clientes.data_nascimento like '%#%' THEN
        NULL
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%Y-%m-%d') IS NOT NULL THEN
      vvr_clientes.data_nascimento
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%d/%m/%Y') IS NOT NULL THEN
      DATE_FORMAT(STR_TO_DATE(vvr_clientes.data_nascimento, '%d/%m/%Y'), '%Y-%m-%d')
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%d-%m-%Y') IS NOT NULL THEN
        DATE_FORMAT(STR_TO_DATE(vvr_clientes.data_nascimento, '%d-%m-%Y'), '%Y-%m-%d')
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%m-%d-%Y') IS NOT NULL THEN
        DATE_FORMAT(STR_TO_DATE(vvr_clientes.data_nascimento, '%m-%d-%Y'), '%Y-%m-%d')
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%m/%d/%Y') IS NOT NULL THEN
        DATE_FORMAT(STR_TO_DATE(vvr_clientes.data_nascimento, '%m/%d/%Y'), '%Y-%m-%d')
    WHEN STR_TO_DATE(vvr_clientes.data_nascimento, '%Y%m%d') IS NOT NULL THEN
        DATE_FORMAT(STR_TO_DATE(vvr_clientes.data_nascimento, '%Y%m%d'), '%Y-%m-%d')
		ELSE
      NULL
  END AS data_nascimento,
	CONCAT('cli_',vvr_clientes.codigo_do_cliente) as original_cod
FROM vvr_clientes
WHERE
vvr_clientes.cpf_cnpj &lt;&gt; ''
AND
vvr_clientes.nome_do_cliente &lt;&gt; ''
AND
CHAR_LENGTH(NumericOnly(vvr_clientes.cpf_cnpj)) in (11,14)
AND
NOT EXISTS ( SELECT 1 FROM app_participants u WHERE u.document = NumericOnly(vvr_clientes.cpf_cnpj));

</sql>
    <update_field/>
    <attributes/>
    <GUI>
      <xloc>512</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
