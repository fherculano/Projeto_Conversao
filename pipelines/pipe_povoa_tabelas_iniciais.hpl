    <sql>-- Desabilita a verificação de chaves estrangeiras
SET FOREIGN_KEY_CHECKS = 0;

-- Limpa as tabelas e reseta o autoincremento
TRUNCATE TABLE app_product_brand;

COMMIT;


INSERT INTO app_product_brand (id_company, id_brand, id_product)
SELECT DISTINCT
  ${par_empresa_que_criou},
	(SELECT app_brand.id FROM app_brand WHERE app_brand.brand = vvr_produtos.nome_da_marca LIMIT 1),
  (SELECT id FROM app_products WHERE app_products.original_cod = vvr_produtos.codigo_do_produto LIMIT 1)

FROM
	vvr_produtos
WHERE
  vvr_produtos.nome_da_marca is not null;

COMMIT;

-- Reabilita a verificação de chaves estrangeiras
SET FOREIGN_KEY_CHECKS = 1;

COMMIT;


</sql>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>832</yloc>
    </GUI>
