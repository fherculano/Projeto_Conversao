    <sql>SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE app_products_price;
TRUNCATE TABLE app_products_price_temp_calc;
SET FOREIGN_KEY_CHECKS = 1;</sql>
    <set_params>N</set_params>
