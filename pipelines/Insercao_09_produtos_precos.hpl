  <transform>
    <name>Inclui os dados em app_products_price</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB_DEV_CONVERSAO</connection>
    <execute_each_row>N</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>SET @empresa = ${par_empresa_que_criou};

INSERT INTO app_products_price( 
	id,
	id_company,
	id_product,
	sale_price,
	min_price,
	status, 
	minimum_margin,
	margin,
	maximum_margin,
 purchase_price,
 purchase_cost
)
SELECT DISTINCT
	NULL AS id, 
	@empresa AS id_company, 
	id AS id_product, 
	coalesce(vvr_produtos.preco_venda,0), 
	0, 
	`status`, 
	0 AS minimum_margin, 
	0 AS margin, 
	0 AS maximum_margin, 
	coalesce(vvr_produtos.preco_custo,0),
	coalesce(vvr_produtos.preco_custo,0)
FROM
	app_products
	INNER JOIN
	vvr_produtos
	ON 
		app_products.original_cod = vvr_produtos.codigo_do_produto;	</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
