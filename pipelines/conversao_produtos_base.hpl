    <sql>DROP TABLE IF EXISTS vvr_produtos;

CREATE TABLE vvr_produtos
(
  codigo_do_produto INT
, codigo_de_barras TINYTEXT
, descricao TINYTEXT
, referencia TINYTEXT
, ncm TINYTEXT
, cst TINYTEXT
, cest TINYTEXT
, preco_venda DECIMAL(18, 2)
, peso_bruto DECIMAL(18, 3)
, cfop TINYTEXT
, estoque DECIMAL(18, 3)
, estoque_minimo DECIMAL(18, 3)
, preco_custo DECIMAL(18, 2)
, descricao_grupo TINYTEXT
, subgrupo TINYTEXT
, margem DECIMAL(18, 2)
, unidade_de_venda TINYTEXT
, tax_table_01_ff_ii_nn TINYTEXT
, codigo_fornecedor_principal INT
, razao_fornecedor_principal TINYTEXT
, nome_da_marca TINYTEXT
, tipo_do_produto TINYTEXT
)
;</sql>
