    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

function ifnull(valor, valorPadrao) {
  return valor !== null &amp;&amp; valor !== undefined ? valor : valorPadrao;
}

function tiraAcentos(atexto) {
  var texto = atexto;
	texto = texto.replace(/[áàâäãå]/g, "a");
	texto = texto.replace(/[ÁÀÂÄÃÅ]/g, "A");
	texto = texto.replace(/[éèêë]/g, "e");
	texto = texto.replace(/[ÉÈÊË]/g, "E");
	texto = texto.replace(/[íìîï]/g, "i");
	texto = texto.replace(/[ÍÌÎÏ]/g, "I");
	texto = texto.replace(/[óòôöõ]/g, "o");
	texto = texto.replace(/[ÓÒÔÖÕ]/g, "O");
	texto = texto.replace(/[úùûü]/g, "u");
	texto = texto.replace(/[ÚÙÛÜ]/g, "U");
	texto = texto.replace(/[ç]/g, "c");
	texto = texto.replace(/[Ç]/g, "C");
	texto = texto.replace(/[ñ]/g, "n");
	texto = texto.replace(/[Ñ]/g, "N");
  return texto;
}

function tiraNaoAlfaNum(atexto) {
  var texto = atexto;
	texto = texto.replace(/[^a-zA-Z0-9]/g, " ");
  return texto;
}

function tiraMaisDeUmEspaço(atexto) {
  var texto = atexto;
	texto = texto.replace(/  +/g, " ");
  return texto;
}


function possuiApenasNumeros(s) {
  return /^[0-9]+$/.test(s);
}


function extrairNumeros(texto) {
  if (texto == null) {
    return ""; // Retorna string vazia se o texto for nulo
  }
  
  var numeros = texto.replace(/\D/g, ''); // Remove tudo que não é número
  return numeros;
}


function converterValores(valorString) {
  if (valorString == null) {
      return ""; // Retorna string vazia se o preço for nulo
  }
  
  var valorSemPontos = valorString.replace(/\./g, ''); // Remove os pontos
  var valorComPonto = valorSemPontos.replace(/,/g, '.'); // Substitui a vírgula por ponto
  return valorComPonto;
}

//===========================================================

//Replaces pre


preco_venda = ifnull(preco_venda, "").replace('\\N','0');

peso_bruto = ifnull(peso_bruto, "").replace('\\N','0');

estoque = ifnull(estoque, "").replace('\\N','0');

estoque_minimo = ifnull(estoque_minimo, "").replace('\\N','0');

preco_custo = ifnull(preco_custo, "").replace('\\N','0');

margem = ifnull(margem, "").replace('\\N','0');

subgrupo = ifnull(subgrupo, "").replace('\\N','');

referencia = ifnull(referencia, "").replace('\\N','');

codigo_do_produto = ifnull(codigo_do_produto, "").replace('\\N','');

codigo_de_barras = ifnull(codigo_de_barras, "").replace('\\N','');

descricao = ifnull(descricao, "").replace('\\N','');

cst = ifnull(cst, "").replace('\\N','');

cest = ifnull(cest, "").replace('\\N','');

cfop = ifnull(cfop, "").replace('\\N','');

descricao_grupo = ifnull(descricao_grupo, "").replace('\\N','');

unidade_de_venda = ifnull(unidade_de_venda, "").replace('\\N','');

tax_table_01_ff_ii_nn = ifnull(tax_table_01_ff_ii_nn, "").replace('\\N','');

codigo_fornecedor_principal = ifnull(codigo_fornecedor_principal, "").replace('\\N','');

razao_fornecedor_principal = ifnull(razao_fornecedor_principal, "").replace('\\N','');

nome_da_marca = ifnull(nome_da_marca, "").replace('\\N','');

tipo_do_produto = ifnull(tipo_do_produto, "").replace('\\N','');

ncm = ifnull(ncm, "").replace('\\N','');


//===========================================================

//Retira os acentos

descricao = tiraAcentos(ifnull(descricao,"")); 

descricao = tiraNaoAlfaNum(ifnull(descricao,"")); 

descricao = upper(descricao); 

descricao = tiraMaisDeUmEspaço(ifnull(descricao,"")); 

//=====

descricao_grupo = tiraAcentos(ifnull(descricao_grupo,"")); 

descricao_grupo = tiraNaoAlfaNum(ifnull(descricao_grupo,"")); 

descricao_grupo = upper(descricao_grupo); 

descricao_grupo = tiraMaisDeUmEspaço(ifnull(descricao_grupo,"")); 

//=====

subgrupo = tiraAcentos(ifnull(subgrupo,"")); 

subgrupo = tiraNaoAlfaNum(ifnull(subgrupo,"")); 

subgrupo = upper(subgrupo); 

subgrupo = tiraMaisDeUmEspaço(ifnull(subgrupo,""));

//=====


nome_da_marca = tiraAcentos(ifnull(nome_da_marca,"")); 

nome_da_marca = tiraNaoAlfaNum(ifnull(nome_da_marca,"")); 

nome_da_marca = upper(nome_da_marca); 

nome_da_marca = tiraMaisDeUmEspaço(ifnull(nome_da_marca,""));



//Retira os caracteres não numéricos
codigo_de_barras = extrairNumeros(codigo_de_barras); 
ncm = extrairNumeros(ncm); 
cest = extrairNumeros(cest); 

//Converte valores (#.###,## para ####.##)

preco_venda = converterValores(preco_venda);

estoque = converterValores(estoque);

estoque_minimo = converterValores(estoque_minimo);

preco_custo = converterValores(preco_custo);

margem = converterValores(margem);

//Extrair só Numeros

cfop = extrairNumeros(cfop);

//Replaces pós

descricao_grupo = descricao_grupo.replace('DECOR AAO','DECORACAO');

//Tratamento de dados

    if (codigo_de_barras == null || codigo_de_barras === undefined || codigo_de_barras === '') {
      codigo_de_barras = codigo_do_produto;
  }</jsScript_script>
      </jsScript>
