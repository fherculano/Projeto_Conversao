      <script>@echo off
setlocal

echo [INFO] Gerando dump da estrutura do banco alcantara_1...
echo [INFO] Salvando em C:\tmp\estrutura_alcantara.sql

mariadb-dump -h 127.0.0.1 -P 3308 -u root -pYhcJGc1iFeyapBgQ60LipX3u9uksxX5M --ssl=0 --no-data --routines --events --triggers  --single-transaction --skip-lock-tables alcantara_1  > C:\tmp\estrutura_alcantara.sql

if %ERRORLEVEL% NEQ 0 (
  echo [ERRO] Falha ao gerar o dump da estrutura.
  exit /b 1
)

echo [SUCESSO] Dump gerado com sucesso em C:\tmp\estrutura_alcantara.sql

endlocal
</script>
