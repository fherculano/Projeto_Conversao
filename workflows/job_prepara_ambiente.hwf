      <insertScript>Y</insertScript>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <script>@echo off
setlocal EnableExtensions

set "OUTPUT_DIR=${PROJECT_HOME}\dumps"
set "OUTPUT_SQL=%OUTPUT_DIR%\alcantara_1_estrutura_completa.sql"

if not exist "%OUTPUT_DIR%" mkdir "%OUTPUT_DIR%"
if exist "%OUTPUT_SQL%" del /f /q "%OUTPUT_SQL%"

echo [INFO] Gerando dump completo da estrutura sem dados...
mariadb-dump --protocol=tcp --host=127.0.0.1 --port=3308 --user=root --password=YhcJGc1iFeyapBgQ60LipX3u9uksxX5M --ssl=0 --default-character-set=utf8mb4 --skip-tz-utc --no-data --routines --triggers --events --single-transaction alcantara_1 > "%OUTPUT_SQL%"

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao gerar o dump completo da estrutura.
 exit /b 1
)

echo [INFO] Normalizando timezone no dump final...
powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-Content -Raw '%OUTPUT_SQL%').Replace('America/Sao_Paulo','-03:00') | Set-Content -Encoding UTF8 '%OUTPUT_SQL%'"

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao normalizar timezone no dump final.
 exit /b 1
)

echo [OK] Dump estrutural criado com sucesso em:
echo [OK] %OUTPUT_SQL%

endlocal
</script>
