      <insertScript>Y</insertScript>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <script>@echo off
setlocal EnableExtensions

set "DB_NAME=alcantara_1"
set "OUTPUT_DIR=${PROJECT_HOME}\dumps"
set "OUTPUT_SQL=%OUTPUT_DIR%\estrutura_completa_da_origem.sql"
set "TEMP_SQL=%OUTPUT_DIR%\estrutura_completa_da_origem.tmp.sql"

if not exist "%OUTPUT_DIR%" mkdir "%OUTPUT_DIR%"
if exist "%OUTPUT_SQL%" del /f /q "%OUTPUT_SQL%"
if exist "%TEMP_SQL%" del /f /q "%TEMP_SQL%"

echo [INFO] Gerando dump completo da estrutura sem dados...
mariadb-dump --protocol=tcp --host=127.0.0.1 --port=3308 --user=root --password=YhcJGc1iFeyapBgQ60LipX3u9uksxX5M --ssl=0 --default-character-set=utf8mb4 --skip-tz-utc --no-data --routines --triggers --events --single-transaction "%DB_NAME%" > "%OUTPUT_SQL%"

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao gerar o dump completo da estrutura.
 exit /b 1
)

echo [INFO] Removendo referencias ao schema no dump gerado...
sed -E "/^-- Host: .* Database: %DB_NAME%$/d; /^-- Dumping (events|routines) for database '%DB_NAME%'$/d; s/`%DB_NAME%`\.`/`/g" "%OUTPUT_SQL%" > "%TEMP_SQL%"

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao sanitizar o dump gerado.
 exit /b 1
)

move /y "%TEMP_SQL%" "%OUTPUT_SQL%" >nul

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao substituir o dump sanitizado.
 exit /b 1
)

echo [OK] Dump estrutural criado com sucesso em:
echo [OK] %OUTPUT_SQL%

endlocal
</script>
