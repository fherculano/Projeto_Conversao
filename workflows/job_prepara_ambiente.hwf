      <script>@echo off
setlocal EnableExtensions

set "OUTPUT_DIR=${PROJECT_HOME}\dumps"
set "OUTPUT_SQL=%OUTPUT_DIR%\estrutura_completa_da_origem.sql"
set "SSH_HOST=72.61.130.215"
set "SSH_PORT=22"
set "SSH_USER=root"
set "REMOTE_SQL=/tmp/estrutura_completa_da_origem.sql"

if not exist "%OUTPUT_SQL%" (
 echo [ERRO] Dump estrutural nao encontrado em:
 echo [ERRO] %OUTPUT_SQL%
 exit /b 1
)

if "%SSH_HOST%"=="PREENCHER_HOST_SSH" (
 echo [ERRO] Preencha a variavel SSH_HOST no workflow job_z_teste_wf.hwf
 exit /b 1
)

if "%SSH_USER%"=="PREENCHER_USUARIO_SSH" (
 echo [ERRO] Preencha a variavel SSH_USER no workflow job_z_teste_wf.hwf
 exit /b 1
)

echo [INFO] Copiando dump para o servidor Linux...
scp -P %SSH_PORT% "%OUTPUT_SQL%" %SSH_USER%@%SSH_HOST%:%REMOTE_SQL%

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha ao copiar o dump para o servidor Linux.
 exit /b 1
)

echo [INFO] Importando estrutura localmente no servidor Linux...
ssh -p %SSH_PORT% %SSH_USER%@%SSH_HOST% "mariadb --protocol=tcp --host=127.0.0.1 --port=3306 --user=root --password=YhcJGc1iFeyapBgQ60LipX3u9uksxX5M --ssl=0 --force --default-character-set=utf8mb4 base_conversoes &lt; %REMOTE_SQL%"

if %ERRORLEVEL% NEQ 0 (
 echo [ERRO] Falha na importacao remota da estrutura.
 exit /b 1
)

echo [OK] Estrutura importada no servidor Linux.

endlocal
</script>
